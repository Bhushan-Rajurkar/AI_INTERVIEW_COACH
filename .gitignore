# ==========================================
# AI Coach Interview - Root .gitignore
# ==========================================

# Secrets and Environment Variables (NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
*.key
*.pem
*.secret
credentials.json

# Maven & Build Artifacts
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Node & Frontend Dependencies / Bundles
node_modules/
frontend/node_modules/
frontend/dist/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDEs & Editors
.idea/
*.iws
*.iml
*.ipr
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.classpath
.project
.settings/
.springBeans
.sts4-cache
.apt_generated
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary & Upload Directories
uploads/
temp/
tmp/
*.tmp
