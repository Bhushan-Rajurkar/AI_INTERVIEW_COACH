# ========================================================
# AI Interview Coach - Environment Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# ========================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_coach_interview
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Cloudinary CDN Configuration (Profile Pictures & Assets)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Authentication (HMAC-SHA256 256-bit+ Secret)
JWT_SECRET=your_base64_or_hex_encoded_jwt_secret_min_32_bytes
JWT_EXPIRATION_MS=86400000
JWT_RESET_EXPIRATION_MS=900000
FRONTEND_URL=http://localhost:8080

# Mail & SMTP Relay Configuration (Brevo, Gmail, SendGrid, etc.)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=your_verified_sender_email@example.com
MAIL_DEV_MODE=false

# Google Gemini AI Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_API_KEY=your_google_gemini_api_key_here

